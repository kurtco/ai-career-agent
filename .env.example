# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# DeepSeek Platform (opcional mientras no tengas saldo): https://platform.deepseek.com/api_keys
# Si está vacío, el agente usará solo Gemini.
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_MODEL=deepseek-v4-flash

# Opcional
DAILY_OFFER_LIMIT=30
TIMEZONE=America/Bogota
DB_PATH=data/history.db
SESSION_STATE_PATH=data/session_state.json
CV_PATH=data/cv.md
LINKEDIN_SEARCH_URL=https://www.linkedin.com/jobs/search/?keywords=typescript&location=Colombia
LINKEDIN_EXPORT_PATH=data/linkedin_export
LINKEDIN_PAGE_TIMEOUT=120000

# Dashboard interactivo
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# Abrir reporte HTML automáticamente al terminar (true/false)
AUTO_OPEN_REPORT=true

# Empresas a ignorar (separadas por coma, case-insensitive)
COMPANY_BLACKLIST=BairesDev,Lumenalta,Hire Hangar
